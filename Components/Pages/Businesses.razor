@page "/businesses"
@using BlazorApp1.Controllers
@using BlazorApp1.Entities
@rendermode InteractiveServer
@inject BusinessController BusinessController

<PageTitle>EcoMeal Businesses</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Partner Businesses</h1>
    <a href="business/create" class="btn-eco"><i class="bi bi-plus-lg"></i> Add New</a>
</div>

@if(businesses is null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if(businesses.Count == 0)
{
    <div class="eco-card text-center p-5">
        <i class="bi bi-shop display-1 text-muted mb-3"></i>
        <h3>No businesses yet</h3>
        <p class="text-muted">Start by adding your first partner business.</p>
        <a href="business/create" class="btn-eco mt-2">Add Business</a>
    </div>
}
else
{
    <div class="eco-grid">
        @foreach(var b in businesses)
        {
            <div class="eco-card d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h4 class="mb-0 text-truncate">@b.Name</h4>
                    <span class="eco-badge">@b.BusinessTypeId.ToString()</span>
                </div>
                
                @if (!string.IsNullOrEmpty(b.ImageUrl))
                {
                    <img src="@b.ImageUrl" alt="@b.Name" class="img-fluid rounded mb-3" style="max-height: 150px; object-fit: cover; width: 100%;" />
                }
                
                <p class="text-muted flex-grow-1" style="font-size: 0.95rem;">
                    @(string.IsNullOrWhiteSpace(b.Description) ? "No description provided." : b.Description)
                </p>
                
                <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center text-muted" style="font-size: 0.85rem;">
                    <div class="text-truncate flex-grow-1">
                        <i class="bi bi-geo-alt-fill me-2" style="color: var(--eco-secondary)"></i>
                        <span>@(string.IsNullOrWhiteSpace(b.Address) ? "No address" : b.Address)</span>
                    </div>
                    <div class="d-flex gap-2 ms-2">
                        <a href="business/update/@b.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i> Edit</a>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteBusiness(b.Id)"><i class="bi bi-trash"></i> Delete</button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Business>? businesses;

    protected override async Task OnInitializedAsync()
    {
        businesses = (await BusinessController.GetAll()).Value;
    }

    private async Task DeleteBusiness(Guid id)
    {
        await BusinessController.DeleteAsync(id);
        businesses = (await BusinessController.GetAll()).Value;
    }
}
