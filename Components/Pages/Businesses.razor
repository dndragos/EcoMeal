@page "/businesses"
@using BlazorApp1.Controllers
@using BlazorApp1.Entities
@rendermode InteractiveServer
@inject BusinessController BusinessController
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<PageTitle>EcoMeal Businesses</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Partner Businesses</h1>
    <div class="d-flex gap-2 align-items-center">
        <input type="text" class="form-control" placeholder="Search by name..." @bind="searchTerm" @bind:event="oninput" style="min-width: 200px;" />
        <AuthorizeView Roles="Admin, BusinessManager">
            <a href="business/create" class="btn-eco text-nowrap"><i class="bi bi-plus-lg"></i> Add New</a>
        </AuthorizeView>
    </div>
</div>

@if(FilteredBusinesses is null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if(!FilteredBusinesses.Any())
{
    <div class="eco-card text-center p-5">
        <i class="bi bi-shop display-1 text-muted mb-3"></i>
        <h3>No businesses found</h3>
        <p class="text-muted">No partner businesses match your criteria.</p>
        <AuthorizeView Roles="Admin, BusinessManager">
            <a href="business/create" class="btn-eco mt-2">Add Business</a>
        </AuthorizeView>
    </div>
}
else
{
    <div>
        @foreach (var type in Enum.GetValues<BusinessTypeEnum>())
        {
            var typeBusinesses = FilteredBusinesses?.Where(b => b.BusinessTypeId == type).ToList() ?? new List<Business>();
            if (!typeBusinesses.Any()) continue;

            var currentIndex = categoryIndexes.GetValueOrDefault(type, 0);
            // Ensure index is valid
            var maxIndex = Math.Max(0, typeBusinesses.Count - 3);
            if (currentIndex > maxIndex) 
            {
                currentIndex = maxIndex;
                categoryIndexes[type] = currentIndex;
            }

            var visibleBusinesses = typeBusinesses.Skip(currentIndex).Take(3).ToList();

            <div class="mb-5">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="mb-0 text-success fw-bold">@type.ToString()s</h3>
                    <div class="d-flex gap-2">
                        <button class="btn btn-outline-success rounded-circle shadow-sm" 
                                @onclick="() => Scroll(type, -1)" 
                                disabled="@(currentIndex == 0)"
                                style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; transition: all 0.2s;">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <button class="btn btn-outline-success rounded-circle shadow-sm" 
                                @onclick="() => Scroll(type, 1)" 
                                disabled="@(currentIndex >= maxIndex)"
                                style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; transition: all 0.2s;">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                </div>
                
                <div class="row g-4">
                    @foreach(var b in visibleBusinesses)
                    {
                        <div class="col-md-4">
                            <div class="eco-card d-flex flex-column h-100 shadow-sm" style="cursor: pointer; transition: transform 0.2s ease, box-shadow 0.2s ease;" @onclick="@(() => NavigationManager.NavigateTo($"/business/{b.Id}/packages"))" onmouseover="this.style.transform='translateY(-5px)'; this.style.boxShadow='0 10px 20px rgba(0,0,0,0.1)';" onmouseout="this.style.transform='none'; this.style.boxShadow='0 2px 10px rgba(0,0,0,0.05)';">
                                <div class="d-flex justify-content-between align-items-start mb-3">
                                    <h4 class="mb-0 text-truncate fw-bold">@b.Name</h4>
                                </div>
                                
                                @if (!string.IsNullOrEmpty(b.ImageUrl))
                                {
                                    <img src="@b.ImageUrl" alt="@b.Name" class="img-fluid rounded mb-3" style="max-height: 150px; object-fit: cover; width: 100%;" />
                                }
                                else
                                {
                                    <div class="bg-light rounded mb-3 d-flex align-items-center justify-content-center text-muted" style="height: 150px; width: 100%;">
                                        <i class="bi bi-shop display-4 opacity-50"></i>
                                    </div>
                                }
                                
                                <p class="text-muted flex-grow-1" style="font-size: 0.95rem;">
                                    @(string.IsNullOrWhiteSpace(b.Description) ? "No description provided." : b.Description)
                                </p>
                                
                                <div class="mt-3 pt-3 border-top d-flex justify-content-between align-items-center text-muted" style="font-size: 0.85rem;">
                                    <div class="text-truncate flex-grow-1">
                                        <i class="bi bi-geo-alt-fill me-2 text-success"></i>
                                        <span>@(string.IsNullOrWhiteSpace(b.Address) ? "No address" : b.Address)</span>
                                    </div>
                                    @if (CanModify(b))
                                    {
                                        <div class="d-flex gap-2 ms-2">
                                            <a href="business/update/@b.Id" class="btn btn-sm btn-outline-secondary" @onclick:stopPropagation="true"><i class="bi bi-pencil"></i></a>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteBusiness(b.Id)" @onclick:stopPropagation="true"><i class="bi bi-trash"></i></button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="ms-2">
                                            <button class="btn btn-sm btn-outline-success px-3 fw-bold" @onclick:stopPropagation="true" @onclick="@(() => NavigationManager.NavigateTo($"/business/{b.Id}/packages"))">View</button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Business>? businesses;
    private string searchTerm = "";
    private Dictionary<BusinessTypeEnum, int> categoryIndexes = new();

    private IEnumerable<Business>? FilteredBusinesses =>
        string.IsNullOrWhiteSpace(searchTerm) 
            ? businesses 
            : businesses?.Where(b => b.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    private void Scroll(BusinessTypeEnum type, int direction)
    {
        var currentIndex = categoryIndexes.GetValueOrDefault(type, 0);
        categoryIndexes[type] = currentIndex + direction;
    }

    private Guid? currentUserId;
    private bool isAdmin;
    private bool isBusinessManager;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("Admin");
        isBusinessManager = user.IsInRole("BusinessManager");
        var userIdStr = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(userIdStr, out var id)) {
            currentUserId = id;
        }

        businesses = (await BusinessController.GetAll()).Value;
    }

    private bool CanModify(Business b) 
    {
        if (isAdmin) return true;
        if (isBusinessManager && b.OwnerId == currentUserId) return true;
        return false;
    }

    private async Task DeleteBusiness(Guid id)
    {
        var b = businesses?.FirstOrDefault(x => x.Id == id);
        if (b != null && CanModify(b))
        {
            await BusinessController.DeleteAsync(id);
            businesses = (await BusinessController.GetAll()).Value;
        }
    }
}
