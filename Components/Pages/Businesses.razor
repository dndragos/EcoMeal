@page "/businesses"
@using BlazorApp1.Controllers
@using BlazorApp1.Entities
@implements IDisposable
@rendermode InteractiveServer
@inject BusinessController BusinessController
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using BlazorApp1.Services.Interfaces
@inject IPackageService PackageService

<PageTitle>EcoMeal Businesses</PageTitle>

<!-- Premium Hero -->
<div class="hero-container position-relative overflow-hidden rounded-4 mb-5 shadow-lg mt-3" style="min-height: 320px; padding: 0; background-color: #f8fdfa; border: 1px solid rgba(132, 169, 140, 0.2); display: flex; align-items: center;">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: radial-gradient(circle at 80% 20%, rgba(132, 169, 140, 0.15) 0%, transparent 50%); pointer-events: none;"></div>
    <div class="container position-relative z-1 py-4 h-100 d-flex flex-column justify-content-center">
        <div class="row align-items-center">
            <div class="col-lg-7 text-center text-lg-start mb-4 mb-lg-0">
                <div class="badge bg-white text-success rounded-pill px-3 py-2 mb-3 shadow-sm fw-bold border" style="animation: fadeDown 0.8s ease-out; color: var(--eco-primary) !important;">
                    <i class="bi bi-shop-window text-warning me-1"></i> Local Partners
                </div>
                <h1 class="display-4 fw-bolder mb-3 text-dark" style="letter-spacing: -1px; animation: slideRight 0.8s cubic-bezier(0.16, 1, 0.3, 1);">
                    Discover.<br/>
                    <span style="background: linear-gradient(135deg, var(--eco-primary) 0%, #34d399 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">Rescue. Enjoy.</span>
                </h1>
                <p class="lead text-muted fs-5 fw-light" style="animation: slideRight 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.1s backwards;">
                    Browse our network of sustainable food spots.
                </p>
            </div>
            <div class="col-lg-5" style="animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s backwards;">
                <div class="p-4 bg-white bg-opacity-75 rounded-4 shadow-sm border border-white" style="backdrop-filter: blur(12px);">
                    <div class="input-group input-group-lg shadow-sm rounded-pill overflow-hidden bg-white mb-3 border">
                        <span class="input-group-text bg-white border-0 text-muted ps-4"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control border-0 px-3" placeholder="Search businesses..." value="@searchTerm" @oninput="OnSearchInput" style="box-shadow: none;" />
                    </div>
                    <AuthorizeView Roles="Admin, BusinessManager">
                        <a href="business/create" class="btn btn-eco w-100 fw-bold rounded-pill py-3 d-flex justify-content-center align-items-center shadow-sm">
                            <i class="bi bi-plus-lg me-2"></i> Add New Business
                        </a>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    </div>
</div>

@if (fireDeals.Any())
{
    <div class="container mb-5">
        <h3 class="fw-bold mb-3"><i class="bi bi-fire text-danger me-2"></i>Fire Deals (Available Now)</h3>
        <div id="fireDealsCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-inner rounded-4 shadow-sm">
                <div class="carousel-item active">
                    <div class="row g-3">
                        @foreach (var package in fireDeals.Skip(fireDealsIndex).Take(3))
                        {
                            <div class="col-md-4">
                                <div class="card h-100 border-0 bg-light">
                                    <div class="card-body p-3 text-center">
                                        <h5 class="fw-bold text-dark">@package.Name</h5>
                                        <p class="text-muted small mb-2">@package.Business?.Name</p>
                                        <div class="badge bg-danger rounded-pill px-3 py-2 fs-6">
                                            @package.Price.ToString("C")
                                        </div>
                                        <div class="mt-3">
                                            <a href="/package/@package.Id" class="btn btn-sm btn-outline-danger rounded-pill">View Deal</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
            @if (fireDeals.Count > 3)
            {
                <button class="carousel-control-prev" type="button" @onclick="() => ScrollFireDeals(-3)" style="width: 5%;" disabled="@(fireDealsIndex == 0)">
                    <span class="carousel-control-prev-icon" aria-hidden="true" style="filter: invert(100%); @(fireDealsIndex == 0 ? "opacity: 0.2;" : "opacity: 1;")"></span>
                    <span class="visually-hidden">Previous</span>
                </button>
                <button class="carousel-control-next" type="button" @onclick="() => ScrollFireDeals(3)" style="width: 5%;" disabled="@(fireDealsIndex + 3 >= fireDeals.Count)">
                    <span class="carousel-control-next-icon" aria-hidden="true" style="filter: invert(100%); @(fireDealsIndex + 3 >= fireDeals.Count ? "opacity: 0.2;" : "opacity: 1;")"></span>
                    <span class="visually-hidden">Next</span>
                </button>
            }
        </div>
    </div>
}

@if(isLoading)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if(!categoryBusinesses.Values.Any(list => list.Any()))
{
    <div class="eco-card text-center p-5">
        <i class="bi bi-shop display-1 text-muted mb-3"></i>
        <h3>No businesses found</h3>
        <p class="text-muted">No partner businesses match your criteria.</p>
        <AuthorizeView Roles="Admin, BusinessManager">
            <a href="business/create" class="btn-eco mt-2">Add Business</a>
        </AuthorizeView>
    </div>
}
else
{
    <div>
        @foreach (var type in Enum.GetValues<BusinessTypeEnum>())
        {
            var typeBusinesses = categoryBusinesses.GetValueOrDefault(type) ?? new List<Business>();
            if (!typeBusinesses.Any()) continue;

            var currentIndex = categoryIndexes.GetValueOrDefault(type, 0);
            // Ensure index is valid
            var maxIndex = Math.Max(0, typeBusinesses.Count - 3);
            if (currentIndex > maxIndex) 
            {
                currentIndex = maxIndex;
                categoryIndexes[type] = currentIndex;
            }

            var visibleBusinesses = typeBusinesses.Skip(currentIndex).Take(3).ToList();
            var hasMoreInDb = categoryHasMore.GetValueOrDefault(type, false);

            <div class="mb-5 category-section">
                @{
                    var iconStr = type switch {
                        BusinessTypeEnum.Restaurant => "bi-shop-window",
                        BusinessTypeEnum.Supermarket => "bi-basket2",
                        BusinessTypeEnum.Cafe => "bi-cup-hot",
                        _ => "bi-shop"
                    };
                    
                    var descriptionStr = type switch {
                        BusinessTypeEnum.Restaurant => "Grab a delicious meal from local restaurants.",
                        BusinessTypeEnum.Supermarket => "Rescue fresh produce and daily essentials.",
                        BusinessTypeEnum.Cafe => "Save on baked goods and premium coffee.",
                        _ => "Discover local partners."
                    };
                }
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center mb-4 pb-3 gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-4 d-flex align-items-center justify-content-center shadow-lg" style="width: 64px; height: 64px; background: linear-gradient(135deg, var(--eco-primary) 0%, var(--eco-secondary) 100%); color: white; animation: zoomIn 0.5s cubic-bezier(0.16, 1, 0.3, 1);">
                            <i class="bi @iconStr fs-2"></i>
                        </div>
                        <div>
                            <h3 class="mb-1 fw-bold text-dark h2" style="letter-spacing: -0.5px;">@type.ToString()s</h3>
                            <p class="text-muted mb-0">@descriptionStr</p>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        <button class="btn bg-white rounded-circle shadow-sm border-0" 
                                @onclick="@(async () => await Scroll(type, -1))" 
                                disabled="@(currentIndex == 0)"
                                style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; transition: all 0.2s; color: var(--eco-dark); opacity: @(currentIndex == 0 ? "0.4" : "1");">
                            <i class="bi bi-arrow-left fs-5"></i>
                        </button>
                        <button class="btn bg-white rounded-circle shadow-sm border-0" 
                                @onclick="@(async () => await Scroll(type, 1))" 
                                disabled="@(currentIndex >= maxIndex && !hasMoreInDb)"
                                style="width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; transition: all 0.2s; color: var(--eco-dark); opacity: @((currentIndex >= maxIndex && !hasMoreInDb) ? "0.4" : "1");">
                            <i class="bi bi-arrow-right fs-5"></i>
                        </button>
                    </div>
                </div>
                
                <div class="row g-4">
                    @foreach(var b in visibleBusinesses)
                    {
                        <div class="col-md-4">
                            <div class="eco-card p-0 overflow-hidden d-flex flex-column h-100 shadow-sm position-relative" style="cursor: pointer;" @onclick="@(() => NavigationManager.NavigateTo($"/business/{b.Id}/packages"))">
                                @if (!string.IsNullOrEmpty(b.ImageUrl))
                                {
                                    <img src="@b.ImageUrl" alt="@b.Name" class="img-fluid w-100" style="height: 200px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="w-100 bg-light d-flex align-items-center justify-content-center text-muted" style="height: 200px;">
                                        <i class="bi bi-shop display-1 opacity-25"></i>
                                    </div>
                                }
                                
                                <div class="p-4 d-flex flex-column flex-grow-1 bg-white">
                                    <h4 class="mb-2 text-truncate fw-bold" style="color: var(--eco-dark);">@b.Name</h4>
                                    
                                    <p class="text-muted flex-grow-1 mb-3" style="font-size: 0.95rem; line-height: 1.5;">
                                        @(string.IsNullOrWhiteSpace(b.Description) ? "No description provided." : b.Description)
                                    </p>
                                    
                                    <div class="pt-3 border-top d-flex justify-content-between align-items-center text-muted" style="font-size: 0.9rem;">
                                        <div class="text-truncate flex-grow-1 d-flex align-items-center">
                                            <i class="bi bi-geo-alt-fill me-2 fs-5" style="color: var(--eco-secondary);"></i>
                                            <span class="text-truncate" style="max-width: 80%;">@(string.IsNullOrWhiteSpace(b.Address) ? "No address" : b.Address)</span>
                                        </div>
                                        @if (CanModify(b))
                                        {
                                            <div class="d-flex gap-2 ms-2">
                                                <a href="business/update/@b.Id" class="btn btn-sm btn-light text-secondary rounded-circle shadow-sm" style="width:32px;height:32px;padding:4px;" @onclick:stopPropagation="true"><i class="bi bi-pencil"></i></a>
                                                <button class="btn btn-sm btn-light text-danger rounded-circle shadow-sm" style="width:32px;height:32px;padding:4px;" @onclick="() => DeleteBusiness(b.Id)" @onclick:stopPropagation="true"><i class="bi bi-trash"></i></button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="ms-2">
                                                <button class="btn btn-sm px-3 fw-bold rounded-pill" style="background-color: var(--eco-bg); color: var(--eco-primary);" @onclick:stopPropagation="true" @onclick="@(() => NavigationManager.NavigateTo($"/business/{b.Id}/packages"))">View</button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private Dictionary<BusinessTypeEnum, List<Business>> categoryBusinesses = new();
    private Dictionary<BusinessTypeEnum, bool> categoryHasMore = new();
    private Dictionary<BusinessTypeEnum, int> categoryIndexes = new();
    private string searchTerm = "";
    private bool isLoading = true;
    private System.Timers.Timer? debounceTimer;

    private int fireDealsIndex = 0;

    private void ScrollFireDeals(int delta)
    {
        fireDealsIndex += delta;
        if (fireDealsIndex < 0) fireDealsIndex = 0;
        if (fireDealsIndex >= fireDeals.Count) fireDealsIndex = Math.Max(0, fireDeals.Count - 3);
    }

    private async Task Scroll(BusinessTypeEnum type, int direction)
    {
        var currentIndex = categoryIndexes.GetValueOrDefault(type, 0);
        var typeBusinesses = categoryBusinesses.GetValueOrDefault(type) ?? new List<Business>();
        
        var newIndex = currentIndex + direction;
        var maxIndex = Math.Max(0, typeBusinesses.Count - 3);
        
        if (newIndex > maxIndex && categoryHasMore.GetValueOrDefault(type, false))
        {
            var res = await BusinessController.GetPaginated(searchTerm, type, typeBusinesses.Count, 6);
            if (res.Value != null)
            {
                var fetched = res.Value;
                typeBusinesses.AddRange(fetched);
                categoryHasMore[type] = fetched.Count == 6;
            }
            maxIndex = Math.Max(0, typeBusinesses.Count - 3);
        }
        
        if (newIndex > maxIndex) newIndex = maxIndex;
        if (newIndex < 0) newIndex = 0;
        
        categoryIndexes[type] = newIndex;
        StateHasChanged();
    }

    private Guid? currentUserId;
    private bool isAdmin;
    private bool isBusinessManager;

    protected override async Task OnInitializedAsync()
    {
        debounceTimer = new System.Timers.Timer(500);
        debounceTimer.AutoReset = false;
        debounceTimer.Elapsed += async (s, e) => { await InvokeAsync(PerformSearch); };

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("Admin");
        isBusinessManager = user.IsInRole("BusinessManager");
        var userIdStr = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(userIdStr, out var id)) {
            currentUserId = id;
        }

        await LoadDataAsync();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        debounceTimer?.Stop();
        debounceTimer?.Start();
    }

    private async Task PerformSearch()
    {
        isLoading = true;
        await InvokeAsync(StateHasChanged);
        await LoadDataAsync();
    }

    private List<Package> fireDeals = new();

    private async Task LoadDataAsync()
    {
        categoryBusinesses.Clear();
        categoryHasMore.Clear();
        categoryIndexes.Clear();

        foreach (var type in Enum.GetValues<BusinessTypeEnum>())
        {
            var res = await BusinessController.GetPaginated(searchTerm, type, 0, 6);
            if (res.Value != null)
            {
                categoryBusinesses[type] = res.Value;
                categoryHasMore[type] = res.Value.Count == 6;
            }
        }
        

        var allPackages = await PackageService.GetAll();
        var currentTime = DateTime.Now.TimeOfDay;
        fireDeals = allPackages.Where(p => 
        {
            if (p.Quantity <= 0) return false;
            var start = p.PickupStart.TimeOfDay;
            var end = p.PickupEnd.TimeOfDay;
            return start <= end ? (currentTime >= start && currentTime <= end) : (currentTime >= start || currentTime <= end);
        }).ToList();

        isLoading = false;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        debounceTimer?.Dispose();
    }

    private bool CanModify(Business b) 
    {
        if (isAdmin) return true;
        if (isBusinessManager && b.OwnerId == currentUserId) return true;
        return false;
    }

    private async Task DeleteBusiness(Guid id)
    {
        Business? b = null;
        foreach(var list in categoryBusinesses.Values) {
            b = list.FirstOrDefault(x => x.Id == id);
            if (b != null) break;
        }

        if (b != null && CanModify(b))
        {
            await BusinessController.DeleteAsync(id);
            await LoadDataAsync();
        }
    }
}
