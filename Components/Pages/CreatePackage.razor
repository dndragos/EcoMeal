@page "/package/create"
@page "/package/update/{Id:guid}"
@rendermode InteractiveServer
@using BlazorApp1.Entities
@using BlazorApp1.Controllers
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Roles = "Admin, BusinessManager")]
@inject PackageController PackageController
@inject BusinessController BusinessController
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@using BlazorApp1.Services.Interfaces
@inject IToastService ToastService

<PageTitle>@(IsEditMode ? "Update Package" : "Create Package") - EcoMeal</PageTitle>

<!-- Premium Form Hero -->
<div class="position-relative overflow-hidden rounded-4 mb-5 shadow-lg mt-3" style="min-height: 80vh; background-color: #f8fdfa; border: 1px solid rgba(132, 169, 140, 0.2); display: flex; align-items: center; justify-content: center; padding: 3rem 1rem;">
    <div class="position-absolute top-0 start-0 w-100 h-100" style="background: radial-gradient(circle at 20% 80%, rgba(132, 169, 140, 0.2) 0%, transparent 50%), radial-gradient(circle at 80% 20%, rgba(52, 211, 153, 0.1) 0%, transparent 50%); animation: rotate 30s linear infinite; pointer-events: none;"></div>
    
    <div class="container position-relative z-1" style="max-width: 800px; animation: slideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1);">
        <div class="text-center mb-4">
            <h1 class="display-5 fw-bolder text-dark" style="letter-spacing: -1px;">@(IsEditMode ? "Update Package" : "Create Package")</h1>
            <p class="text-muted fs-5">@(IsEditMode ? "Modify package details below." : "Add a new sustainable food package.")</p>
        </div>
        
        <div class="p-4 p-md-5 bg-white bg-opacity-75 rounded-4 shadow-lg border border-white" style="backdrop-filter: blur(16px);">
            <EditForm Model="@model" OnValidSubmit="Submit" FormName="createPackageForm">
                <div class="row">
                    <div class="col-md-12 mb-4">
                        <label for="name" class="form-label text-muted fw-bold small text-uppercase tracking-wider">Package Name</label>
                        <InputText id="name" class="form-control form-control-lg bg-white border-0 shadow-sm rounded-3" @bind-Value="model.Name" placeholder="e.g. End of Day Pastries"></InputText>
                    </div>
                </div>
                
                <div class="mb-4">
                    <label for="description" class="form-label text-muted fw-bold small text-uppercase tracking-wider">Description</label>
                    <InputTextArea id="description" class="form-control bg-white border-0 shadow-sm rounded-3" @bind-Value="model.Description" rows="2"></InputTextArea>
                </div>

                <div class="mb-4">
                    <label for="imageUrl" class="form-label text-muted fw-bold small text-uppercase tracking-wider">Image URL (Optional)</label>
                    <InputText id="imageUrl" class="form-control form-control-lg bg-white border-0 shadow-sm rounded-3" @bind-Value="model.ImageUrl" placeholder="https://example.com/image.jpg"></InputText>
                </div>
                
                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label for="price" class="form-label text-muted fw-bold small text-uppercase tracking-wider">Price ($)</label>
                        <InputNumber id="price" class="form-control form-control-lg bg-white border-0 shadow-sm rounded-3" @bind-Value="model.Price"></InputNumber>
                    </div>
                    <div class="col-md-6 mb-4">
                        <label for="quantity" class="form-label text-muted fw-bold small text-uppercase tracking-wider">Quantity Available</label>
                        <InputNumber id="quantity" class="form-control form-control-lg bg-white border-0 shadow-sm rounded-3" @bind-Value="model.Quantity"></InputNumber>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label for="pickupStart" class="form-label text-muted fw-bold small text-uppercase tracking-wider">Pickup Window Starts</label>
                        <InputDate Type="InputDateType.DateTimeLocal" id="pickupStart" class="form-control form-control-lg bg-white border-0 shadow-sm rounded-3" @bind-Value="model.PickupStart"></InputDate>
                    </div>
                    <div class="col-md-6 mb-4">
                        <label for="pickupEnd" class="form-label text-muted fw-bold small text-uppercase tracking-wider">Pickup Window Ends</label>
                        <InputDate Type="InputDateType.DateTimeLocal" id="pickupEnd" class="form-control form-control-lg bg-white border-0 shadow-sm rounded-3" @bind-Value="model.PickupEnd"></InputDate>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label for="packageType" class="form-label text-muted fw-bold small text-uppercase tracking-wider">Package Type</label>
                        <InputSelect id="packageType" class="form-select form-select-lg bg-white border-0 shadow-sm rounded-3" @bind-Value="model.PackageTypeId">
                            @foreach(var type in Enum.GetValues<PackageTypeEnum>())
                            {
                                <option value="@type">@type</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-6 mb-4">
                        <label for="businessId" class="form-label text-muted fw-bold small text-uppercase tracking-wider">Assign to Business</label>
                        <InputSelect id="businessId" class="form-select form-select-lg bg-white border-0 shadow-sm rounded-3" @bind-Value="model.BusinessId">
                            <option value="">Select a business...</option>
                            @if (businesses != null)
                            {
                                @foreach (var business in businesses)
                                {
                                    <option value="@business.Id">@business.Name</option>
                                }
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-3 mt-5 pt-3 border-top">
                    <button type="button" @onclick="Cancel" class="btn btn-light fw-bold rounded-pill px-4 py-2 text-muted">Cancel</button>
                    <button type="submit" class="btn btn-eco fw-bold rounded-pill px-5 py-2 shadow-sm">
                        <i class="bi @(IsEditMode ? "bi-check2-circle" : "bi-plus-circle") me-2"></i>@(IsEditMode ? "Update Package" : "Create Package")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid? Id { get; set; }

    private bool IsEditMode => Id.HasValue;
    private PackageFormModel model = new();
    private List<Business>? businesses;

    private bool isAdmin;
    private Guid? currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("Admin");
        var userIdStr = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(userIdStr, out var id)) {
            currentUserId = id;
        }

        var allBusinesses = (await BusinessController.GetAll()).Value;
        if (isAdmin)
        {
            businesses = allBusinesses;
        }
        else
        {
            businesses = allBusinesses?.Where(b => b.OwnerId == currentUserId).ToList();
        }

        if (IsEditMode)
        {
            var result = await PackageController.GetById(Id.Value);
            var package = result.Value;
            if (package != null)
            {
                model.Name = package.Name;
                model.Description = package.Description;
                model.ImageUrl = package.ImageUrl;
                model.Price = package.Price;
                model.Quantity = package.Quantity;
                model.PickupStart = package.PickupStart;
                model.PickupEnd = package.PickupEnd;
                model.PackageTypeId = package.PackageTypeId;
                model.BusinessId = package.BusinessId;
            }
        }
    }

    private async Task Submit()
    {
        var package = new Package
        {
            Name = model.Name ?? "",
            Description = model.Description,
            ImageUrl = model.ImageUrl,
            Price = model.Price,
            Quantity = model.Quantity,
            PickupStart = model.PickupStart,
            PickupEnd = model.PickupEnd,
            PackageTypeId = model.PackageTypeId,
            BusinessId = model.BusinessId
        };

        if (IsEditMode)
        {
            await PackageController.UpdateAsync(Id.Value, package);
            ToastService.ShowSuccess("Package updated successfully!");
        }
        else
        {
            await PackageController.AddAsync(package);
            ToastService.ShowSuccess("Package created successfully!");
        }

        NavigationManager.NavigateTo($"/business/{package.BusinessId}/packages");
    }

    private void Cancel()
    {
        if (model.BusinessId != Guid.Empty)
        {
            NavigationManager.NavigateTo($"/business/{model.BusinessId}/packages");
        }
        else
        {
            NavigationManager.NavigateTo("/businesses");
        }
    }

    private class PackageFormModel
    {
        public string? Name { get; set; }
        public string? Description { get; set; }
        public string? ImageUrl { get; set; }
        public decimal Price { get; set; }
        public int Quantity { get; set; }
        public DateTime PickupStart { get; set; } = DateTime.Now;
        public DateTime PickupEnd { get; set; } = DateTime.Now.AddHours(2);
        public PackageTypeEnum PackageTypeId { get; set; }
        public Guid BusinessId { get; set; }
    }
}
