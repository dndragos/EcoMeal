@page "/packages"
@page "/business/{BusinessId:guid}/packages"
@using BlazorApp1.Controllers
@using BlazorApp1.Entities
@rendermode InteractiveServer
@inject PackageController PackageController
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims

<PageTitle>EcoMeal Packages</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Available Packages</h1>
    <div class="d-flex gap-2 align-items-center">
        <input type="text" class="form-control" placeholder="Search by name..." @bind="searchTerm" @bind:event="oninput" style="min-width: 200px;" />
        <AuthorizeView Roles="Admin, BusinessManager">
            <a href="package/create" class="btn-eco text-nowrap"><i class="bi bi-plus-lg"></i> Add New</a>
        </AuthorizeView>
    </div>
</div>

@if (FilteredPackages == null)
{
    <div class="d-flex justify-content-center my-5">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else if(!FilteredPackages.Any())
{
    <div class="eco-card text-center p-5">
        <i class="bi bi-box-seam display-1 text-muted mb-3"></i>
        <h3>No packages found</h3>
        <p class="text-muted">No food packages match your criteria.</p>
        <AuthorizeView Roles="Admin, BusinessManager">
            <a href="package/create" class="btn-eco mt-2">Create Package</a>
        </AuthorizeView>
    </div>
}
else
{
    <div class="eco-grid">
        @foreach (var package in FilteredPackages)
        {
            <div class="eco-card d-flex flex-column">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h4 class="mb-0 text-truncate">@package.Name</h4>
                    <span class="eco-badge">@package.PackageTypeId.ToString()</span>
                </div>

                @if (!string.IsNullOrEmpty(package.ImageUrl))
                {
                    <img src="@package.ImageUrl" alt="@package.Name" class="img-fluid rounded mb-3" style="max-height: 150px; object-fit: cover; width: 100%;" />
                }
                
                <h3 class="mb-3" style="color: var(--eco-primary);">@package.Price.ToString("C")</h3>
                
                <p class="text-muted flex-grow-1" style="font-size: 0.95rem;">
                    <strong>Qty:</strong> @package.Quantity available
                </p>
                
                <div class="mt-2 pt-3 border-top d-flex flex-column gap-2 text-muted" style="font-size: 0.85rem;">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="mb-1">
                                <i class="bi bi-clock me-1" style="color: var(--eco-secondary)"></i> 
                                <strong>Pick up:</strong> @package.PickupStart.ToString("MMM dd, HH:mm")
                            </div>
                            <div>
                                <i class="bi bi-clock-history me-1" style="color: #e56b6f"></i>
                                <strong>Ends:</strong> @package.PickupEnd.ToString("MMM dd, HH:mm")
                            </div>
                        </div>
                        @if (CanModify(package))
                        {
                            <div class="d-flex gap-2 ms-2 align-items-center">
                                <a href="package/update/@package.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i> Edit</a>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePackage(package.Id)"><i class="bi bi-trash"></i> Delete</button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Package>? packages;
    private string searchTerm = "";

    private IEnumerable<Package>? FilteredPackages =>
        string.IsNullOrWhiteSpace(searchTerm) 
            ? packages 
            : packages?.Where(p => p.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase));

    [Parameter] public Guid? BusinessId { get; set; }

    private Guid? currentUserId;
    private bool isAdmin;
    private bool isBusinessManager;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isAdmin = user.IsInRole("Admin");
        isBusinessManager = user.IsInRole("BusinessManager");
        var userIdStr = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        if (Guid.TryParse(userIdStr, out var id)) {
            currentUserId = id;
        }

        var allPackages = (await PackageController.GetAll()).Value ?? new List<Package>();
        if (BusinessId.HasValue)
        {
            packages = allPackages.Where(p => p.BusinessId == BusinessId.Value).ToList();
        }
        else
        {
            packages = allPackages;
        }
    }

    private bool CanModify(Package p)
    {
        if (isAdmin) return true;
        if (isBusinessManager && p.Business?.OwnerId == currentUserId) return true;
        return false;
    }

    private async Task DeletePackage(Guid id)
    {
        var p = packages?.FirstOrDefault(x => x.Id == id);
        if (p != null && CanModify(p))
        {
            await PackageController.DeleteAsync(id);
            var allPackages = (await PackageController.GetAll()).Value ?? new List<Package>();
            packages = BusinessId.HasValue 
                ? allPackages.Where(x => x.BusinessId == BusinessId.Value).ToList() 
                : allPackages;
        }
    }
}
