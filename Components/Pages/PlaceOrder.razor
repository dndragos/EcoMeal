@page "/order"
@using BlazorApp1.Entities
@using BlazorApp1.Services.Interfaces
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IOrderService OrderService
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<PageTitle>Your Order</PageTitle>

<div class="container py-5">
    <!-- Compact Header -->
    <div class="d-flex justify-content-between align-items-end mb-4 border-bottom pb-3">
        <div>
            <h2 class="fw-bold mb-1">Your Order</h2>
            <p class="text-muted mb-0">Review your items before confirming</p>
        </div>
        <a href="order/history" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-clock-history me-1"></i> Order History
        </a>
    </div>

    @if (isLoading)
    {
        <div class="d-flex justify-content-center my-5">
            <div class="spinner-border text-success" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>
    }
    else if (!isAuthenticated)
    {
        <div class="eco-card text-center p-5 shadow-sm">
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-light text-muted mb-4" style="width: 120px; height: 120px;">
                <i class="bi bi-person-lock display-1"></i>
            </div>
            <h3 class="fw-bold mb-3" style="color: var(--eco-dark);">Login Required</h3>
            <p class="text-muted mb-4 fs-5">You must be logged in to view and place orders.</p>
            <a href="/account/login?ReturnUrl=@Uri.EscapeDataString("/order")" class="btn-eco rounded-pill px-5 py-3 fs-5 fw-bold shadow-sm"><i class="bi bi-box-arrow-in-right me-2"></i>Log in to Order</a>
        </div>
    }
    else if (!isNormalUser)
    {
        // Should be redirected in OnInitializedAsync
    }
    else if (pendingOrder == null || !pendingOrder.OrderPackages.Any())
    {
        <div class="eco-card text-center p-5 shadow-sm">
            @if (errorMessage != null)
            {
                <div class="alert alert-danger alert-dismissible fade show text-start mb-4">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
                </div>
            }
            <div class="rounded-circle d-inline-flex align-items-center justify-content-center bg-light text-muted mb-4" style="width: 120px; height: 120px;">
                <i class="bi bi-cart-x display-1"></i>
            </div>
            <h3 class="fw-bold mb-3" style="color: var(--eco-dark);">Your cart is empty</h3>
            <p class="text-muted mb-4 fs-5">Please visit a business and add packages to your order.</p>
            <a href="/businesses" class="btn-eco rounded-pill px-5 py-3 fs-5 fw-bold shadow-sm"><i class="bi bi-shop me-2"></i>Browse Businesses</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <!-- Left Column: Business Details -->
            <div class="col-md-5">
                <div class="card border-0 shadow-sm rounded-4 h-100 overflow-hidden" style="animation: slideRight 0.5s ease-out;">
                    @if (!string.IsNullOrEmpty(pendingOrder.Business?.ImageUrl))
                    {
                        <img src="@pendingOrder.Business.ImageUrl" class="card-img-top" style="height: 180px; object-fit: cover;" alt="@pendingOrder.Business.Name" />
                    }
                    else
                    {
                        <div class="bg-light d-flex align-items-center justify-content-center" style="height: 180px;">
                            <i class="bi bi-shop text-muted fs-1 opacity-25"></i>
                        </div>
                    }
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center mb-2">
                            <div class="bg-success bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center me-2" style="width: 36px; height: 36px;">
                                <i class="bi bi-shop text-success fs-5"></i>
                            </div>
                            <h5 class="fw-bold mb-0">@pendingOrder.Business?.Name</h5>
                        </div>
                        <p class="text-secondary small mb-3" style="line-height: 1.4;">
                            @(string.IsNullOrWhiteSpace(pendingOrder.Business?.Description) ? "No description provided." : pendingOrder.Business?.Description)
                        </p>
                        <div class="d-flex align-items-center text-muted bg-light p-2 rounded-3 border small">
                            <i class="bi bi-geo-alt-fill text-danger me-2 fs-6"></i>
                            <span class="fw-medium">@(string.IsNullOrWhiteSpace(pendingOrder.Business?.Address) ? "No address" : pendingOrder.Business?.Address)</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Order Packages -->
            <div class="col-md-7">
                <div class="card border-0 shadow-sm rounded-4 h-100" style="animation: slideUp 0.5s ease-out 0.1s backwards;">
                    <div class="card-body p-3 p-lg-4 d-flex flex-column">
                        @if (errorMessage != null)
                        {
                            <div class="alert alert-danger alert-dismissible fade show mb-3 py-1 shadow-sm small">
                                @errorMessage
                                <button type="button" class="btn-close btn-sm" @onclick="() => errorMessage = null"></button>
                            </div>
                        }
                        
                        <h5 class="fw-bold mb-3">Order Summary</h5>
                        
                        <div class="flex-grow-1 overflow-auto pe-2" style="max-height: 300px;">
                            @foreach (var op in pendingOrder.OrderPackages)
                            {
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="bg-light rounded p-2 text-muted border shadow-sm" style="width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                                            <i class="bi bi-box-seam fs-6"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold small">@op.Package?.Name</h6>
                                            <small class="text-muted fw-medium text-success">@((op.Package?.Price)?.ToString("C"))</small>
                                        </div>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="d-flex align-items-center bg-light rounded-pill border px-1 py-0 shadow-sm">
                                            <button class="btn btn-sm p-0 text-muted" style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;" @onclick="() => UpdateQuantityAsync(op.PackageId, op.Quantity - 1)" disabled="@(pendingOrder.StatusId != StatusEnum.Pending || isProcessing)">
                                                <i class="bi bi-dash"></i>
                                            </button>
                                            <span class="fw-bold px-2 small">@op.Quantity</span>
                                            <button class="btn btn-sm p-0 text-muted" style="width: 20px; height: 20px; display: flex; align-items: center; justify-content: center;" @onclick="() => UpdateQuantityAsync(op.PackageId, op.Quantity + 1)" disabled="@(pendingOrder.StatusId != StatusEnum.Pending || (op.Package?.Quantity ?? 0) <= 0 || isProcessing)">
                                                <i class="bi bi-plus"></i>
                                            </button>
                                        </div>
                                        <span class="fw-bold text-dark small" style="width: 50px; text-align: right;">
                                            @((op.Package?.Price * op.Quantity)?.ToString("C"))
                                        </span>
                                        <button class="btn btn-sm btn-outline-danger rounded-circle ms-2 shadow-sm" style="width: 28px; height: 28px; display: flex; align-items: center; justify-content: center;" @onclick="() => RemovePackageAsync(op.PackageId)" disabled="@(pendingOrder.StatusId != StatusEnum.Pending || isProcessing)">
                                            <i class="bi bi-trash" style="font-size: 0.8rem;"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="mt-3 pt-3 border-top">
                            <div class="d-flex justify-content-between align-items-end mb-3 bg-light rounded-4 p-3 border">
                                <span class="fw-bold text-muted small text-uppercase">Total Amount</span>
                                <h4 class="mb-0 fw-bold text-success">@pendingOrder.OrderPackages.Sum(op => op.Package?.Price * op.Quantity)?.ToString("C")</h4>
                            </div>
                            
                            @if (pendingOrder.StatusId == StatusEnum.Pending)
                            {
                                <div class="text-end">
                                    <button class="btn btn-success px-4 py-2 rounded-pill fw-bold shadow-sm" @onclick="BuyOrderAsync" style="min-width: 150px;" disabled="@(isProcessing)">
                                        @if (isProcessing)
                                        {
                                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                                        }
                                        else
                                        {
                                            <i class="bi bi-credit-card me-1"></i>
                                        }
                                        Confirm & Pay
                                    </button>
                                </div>
                            }
                            else if (pendingOrder.StatusId == StatusEnum.Approved)
                            {
                                <div class="text-center p-3 border border-warning rounded-4 shadow-sm" style="background-color: #fffdf5;">
                                    <div class="spinner-border spinner-border-sm text-warning mb-2" role="status"></div>
                                    <h6 class="fw-bold text-warning mb-1">Wait... The order is being prepared!</h6>
                                    <p class="text-muted small mb-3">The business is packing your requested items.</p>
                                    <div class="text-end">
                                        <button class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1 fw-bold" @onclick="CancelOrderAsync" disabled="@(isProcessing)">Cancel Order</button>
                                    </div>
                                </div>
                            }
                            else if (pendingOrder.StatusId == StatusEnum.Canceled)
                            {
                                <div class="text-center p-3 border border-danger rounded-4 bg-light shadow-sm">
                                    <i class="bi bi-x-circle text-danger fs-3 mb-1"></i>
                                    <h6 class="fw-bold text-danger mb-0">Order Canceled</h6>
                                </div>
                            }
                            else if (pendingOrder.StatusId == StatusEnum.Delivered)
                            {
                                <div class="text-center p-3 border border-success rounded-4 bg-light shadow-sm">
                                    <i class="bi bi-check-circle text-success fs-3 mb-1"></i>
                                    <h6 class="fw-bold text-success mb-2">Order Completed!</h6>
                                    <p class="text-muted small mb-2">How was your package? Leave a review to help others.</p>
                                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                                        @foreach(var op in pendingOrder.OrderPackages)
                                        {
                                            <a href="/package/@op.PackageId" class="btn btn-outline-success btn-sm rounded-pill fw-bold px-2 py-1">Review @op.Package?.Name</a>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private Order? pendingOrder;
    private bool isLoading = true;
    private string? errorMessage;
    private Guid currentUserId;
    private bool isNormalUser;
    private bool isAuthenticated;
    private bool isProcessing = false;
    private int secondsRemaining = 10;
    private bool isTimerRunning = false;
    private static readonly Dictionary<Guid, DateTime> orderApprovalTimes = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        var userIdStr = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (Guid.TryParse(userIdStr, out var id))
        {
            isAuthenticated = true;
            currentUserId = id;
            isNormalUser = !user.IsInRole(BlazorApp1.Constants.AppRoles.Admin) && !user.IsInRole(BlazorApp1.Constants.AppRoles.BusinessManager);
            if (isNormalUser)
            {
                await LoadOrderAsync();
            }
            else
            {
                if (user.IsInRole(BlazorApp1.Constants.AppRoles.Admin))
                {
                    NavigationManager.NavigateTo("/admin");
                }
                else
                {
                    NavigationManager.NavigateTo("/my-business");
                }
            }
        }
        else
        {
            isAuthenticated = false;
            errorMessage = "You must be logged in to view your order.";
            isLoading = false;
        }
    }

    private async Task LoadOrderAsync()
    {
        isLoading = true;
        pendingOrder = await OrderService.GetPendingOrderForUserAsync(currentUserId);
        
        if (pendingOrder != null && pendingOrder.StatusId == StatusEnum.Approved && !isTimerRunning)
        {
            if (orderApprovalTimes.TryGetValue(pendingOrder.Id, out var approvalTime))
            {
                var elapsed = (DateTime.UtcNow - approvalTime).TotalSeconds;
                secondsRemaining = Math.Max(0, 10 - (int)elapsed);
            }
            else
            {
                secondsRemaining = 10;
                orderApprovalTimes[pendingOrder.Id] = DateTime.UtcNow;
            }

            isTimerRunning = true;
            _ = RunTimerAsync();
        }

        isLoading = false;
        StateHasChanged();
    }

    private async Task BuyOrderAsync()
    {
        if (isProcessing) return;
        isProcessing = true;
        try
        {
            if (pendingOrder != null)
            {
                pendingOrder.StatusId = StatusEnum.Approved;
                await OrderService.UpdateStatusAsync(pendingOrder.Id, StatusEnum.Approved);
                
                secondsRemaining = 10;
                orderApprovalTimes[pendingOrder.Id] = DateTime.UtcNow;
                
                isTimerRunning = true;
                StateHasChanged();

                // Start countdown
                _ = RunTimerAsync();
            }
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task CancelOrderAsync()
    {
        if (isProcessing) return;
        isProcessing = true;
        try
        {
            if (pendingOrder != null && isTimerRunning)
            {
                isTimerRunning = false;
                pendingOrder.StatusId = StatusEnum.Canceled;
                await OrderService.CancelOrderWithRestorationAsync(pendingOrder.Id);
                orderApprovalTimes.Remove(pendingOrder.Id);
                StateHasChanged();
            }
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task RunTimerAsync()
    {
        while (secondsRemaining > 0 && isTimerRunning)
        {
            await Task.Delay(1000);
            if (isTimerRunning)
            {
                if (pendingOrder != null && orderApprovalTimes.TryGetValue(pendingOrder.Id, out var approvalTime))
                {
                    var elapsed = (DateTime.UtcNow - approvalTime).TotalSeconds;
                    secondsRemaining = Math.Max(0, 10 - (int)elapsed);
                }
                else
                {
                    secondsRemaining--;
                }
                await InvokeAsync(StateHasChanged);
            }
        }

        if (isTimerRunning) // If timer finished naturally without cancel
        {
            isTimerRunning = false;
            if (pendingOrder != null)
            {
                pendingOrder.StatusId = StatusEnum.Delivered;
                await OrderService.UpdateStatusAsync(pendingOrder.Id, StatusEnum.Delivered);
                orderApprovalTimes.Remove(pendingOrder.Id);
                await InvokeAsync(StateHasChanged);
            }
        }
    }
    private async Task RemovePackageAsync(Guid packageId)
    {
        if (isProcessing) return;
        isProcessing = true;
        try
        {
            errorMessage = null;
            var result = await OrderService.RemovePackageFromPendingOrderAsync(currentUserId, packageId);
            if (result != null)
            {
                errorMessage = result;
            }
            await LoadOrderAsync();
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task UpdateQuantityAsync(Guid packageId, int newQty)
    {
        if (isProcessing) return;
        isProcessing = true;
        try
        {
            errorMessage = null;
            if (newQty <= 0)
            {
                // we call the service directly here to avoid nested isProcessing checks
                var remResult = await OrderService.RemovePackageFromPendingOrderAsync(currentUserId, packageId);
                if (remResult != null) errorMessage = remResult;
                await LoadOrderAsync();
                return;
            }

            var result = await OrderService.UpdatePackageQuantityAsync(currentUserId, packageId, newQty);
            if (result != null)
            {
                errorMessage = result;
            }
            await LoadOrderAsync();
        }
        finally
        {
            isProcessing = false;
        }
    }
}
