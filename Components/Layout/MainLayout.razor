@inherits LayoutComponentBase

<div class="page d-flex flex-column min-vh-100">
    <header class="eco-top-nav">
        <NavMenu />
    </header>

    <main class="flex-grow-1">
        <article class="content px-4 container mt-4">
            @Body
        </article>
    </main>
    
    <footer class="text-center p-4 mt-auto text-muted">
        <small>&copy; @DateTime.Now.Year EcoMeal. All rights reserved.</small>
    </footer>
    
    <ToastContainer />
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    .eco-top-nav {
        background: linear-gradient(90deg, var(--eco-dark) 0%, var(--eco-primary) 100%);
        box-shadow: 0 4px 15px rgba(0,0,0,0.1);
        position: sticky;
        top: 0;
        z-index: 1000;
        animation: navSlideDown 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    @@keyframes navSlideDown {
        from { transform: translateY(-100%); }
        to { transform: translateY(0); }
    }
</style>
